{
  "opencollection": "1.0.0",
  "info": {
    "name": "ArcBest Pickups Shipments API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shipments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ArcBest List Shipments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.arcbest.com/v2/shipments",
            "params": [
              {
                "name": "startDate",
                "value": "2026-04-01",
                "type": "query",
                "description": "Start date filter (YYYY-MM-DD)"
              },
              {
                "name": "endDate",
                "value": "2026-04-19",
                "type": "query",
                "description": "End date filter (YYYY-MM-DD)"
              },
              {
                "name": "status",
                "value": "IN_TRANSIT",
                "type": "query",
                "description": "Filter by shipment status"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List shipments with optional filtering by date range and status."
        },
        {
          "info": {
            "name": "ArcBest Create Shipment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.arcbest.com/v2/shipments",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Book a new LTL freight shipment and generate a Bill of Lading."
        }
      ]
    }
  ],
  "bundled": true
}